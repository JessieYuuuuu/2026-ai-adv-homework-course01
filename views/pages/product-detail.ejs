<div id="app" class="product-page" data-product-id="<%= productId %>">
  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="notFound" class="empty-state text-center py-16">
    <div class="text-5xl mb-4">✿</div>
    <h2>找不到此商品</h2>
    <a href="/#products">回到本季作品</a>
  </div>

  <template v-else-if="product">
    <nav class="product-breadcrumb" aria-label="麵包屑">
      <a href="/#products">本季作品</a><span>/</span><span>{{ product.name }}</span>
    </nav>

    <div class="product-layout">
      <div class="product-gallery">
        <div class="product-main-image">
          <img
            :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=900'"
            :alt="product.name"
          >
        </div>
        <div class="product-thumbnails" aria-hidden="true">
          <img v-for="n in 3" :key="n" :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=240'" alt="">
        </div>
      </div>

      <section class="product-copy" aria-labelledby="product-title">
        <p class="product-collection">本季花藝作品</p>
        <h1 id="product-title">{{ product.name }}</h1>
        <p class="product-price">NT$ {{ product.price.toLocaleString() }}</p>
        <p class="product-stock"><span aria-hidden="true"></span>尚有 {{ product.stock }} 件</p>
        <p class="product-description">{{ product.description }}</p>

        <div class="product-quantity">
          <span>數量</span>
          <div class="quantity-control">
            <button type="button" aria-label="減少數量" @click="decrease">−</button>
            <span>{{ quantity }}</span>
            <button type="button" aria-label="增加數量" @click="increase">＋</button>
          </div>
        </div>

        <button
          type="button"
          class="product-add-button"
          :disabled="adding || product.stock <= 0"
          @click="addToCart"
        >
          {{ product.stock <= 0 ? '已售完' : (adding ? '加入中…' : '加入購物車') }}
        </button>

        <div class="purchase-notes">
          <h2>購買須知</h2>
          <p>花材依季節供應調整｜台北市區提供當日配送｜消費滿 NT$ 500 享免運</p>
        </div>
      </section>
    </div>
  </template>
</div>
