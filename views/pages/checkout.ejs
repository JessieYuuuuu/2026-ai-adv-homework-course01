<div id="app" class="checkout-page">
  <div class="checkout-progress" aria-label="結帳進度">
    <span><b>01</b> 購物車</span><span class="is-current"><b>02</b> 配送與付款</span><span><b>03</b> 訂單完成</span>
  </div>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-brand-gold border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else class="checkout-layout content-shell">
    <section class="checkout-form">
      <h1>完成您的訂單</h1>
      <p class="checkout-intro">填寫收件資訊後，前往綠界安全付款頁面完成付款。</p>

      <div class="checkout-section">
        <div class="space-y-4">
          <div>
            <label class="block text-sm text-text-secondary mb-1">收件人姓名</label>
            <input v-model="form.recipientName" type="text" placeholder="請輸入收件人姓名" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand-gold transition-colors" :class="{ 'border-red-400': errors.recipientName }">
            <p v-if="errors.recipientName" class="text-red-500 text-xs mt-1">{{ errors.recipientName }}</p>
          </div>
          <div>
            <label class="block text-sm text-text-secondary mb-1">電子郵件</label>
            <input v-model="form.recipientEmail" type="email" placeholder="name@example.com" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand-gold transition-colors" :class="{ 'border-red-400': errors.recipientEmail }">
            <p v-if="errors.recipientEmail" class="text-red-500 text-xs mt-1">{{ errors.recipientEmail }}</p>
          </div>
          <div>
            <label class="block text-sm text-text-secondary mb-1">收件地址</label>
            <input v-model="form.recipientAddress" type="text" placeholder="請輸入完整配送地址" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand-gold transition-colors" :class="{ 'border-red-400': errors.recipientAddress }">
            <p v-if="errors.recipientAddress" class="text-red-500 text-xs mt-1">{{ errors.recipientAddress }}</p>
          </div>
        </div>
      </div>

      <div class="payment-method">
        <h2>付款方式</h2>
        <div class="ecpay-option">
          <span class="ecpay-radio" aria-hidden="true"></span>
          <div><strong>綠界 ECPay 安全付款</strong><small>支援信用卡及綠界提供的付款方式</small></div>
          <span>安全加密</span>
        </div>
      </div>

      <div class="delivery-option">
        <div class="delivery-heading">
          <h2>配送方式</h2>
          <p>選擇最適合您的收花方式</p>
        </div>
        <div class="delivery-choices">
          <label class="delivery-choice" :class="{ 'is-selected': deliveryType === 'home_delivery' }">
            <input type="radio" name="deliveryType" value="home_delivery" v-model="deliveryType">
            <span class="delivery-choice__mark" aria-hidden="true">宅</span>
            <span class="delivery-choice__copy">
              <strong>宅配到府</strong>
              <small>送達您填寫的收件地址</small>
            </span>
            <span class="delivery-choice__price">
              <del v-if="freeBasicShipping">NT$ {{ homeDeliveryFee.toLocaleString() }}</del>
              <strong>{{ freeBasicShipping ? '滿額免運' : 'NT$ ' + homeDeliveryFee.toLocaleString() }}</strong>
            </span>
          </label>
          <label class="delivery-choice" :class="{ 'is-selected': deliveryType === 'convenience_store' }">
            <input type="radio" name="deliveryType" value="convenience_store" v-model="deliveryType">
            <span class="delivery-choice__mark" aria-hidden="true">店</span>
            <span class="delivery-choice__copy">
              <strong>超商取貨</strong>
              <small>送達指定便利商店門市</small>
            </span>
            <span class="delivery-choice__price">
              <strong>NT$ {{ convenienceStoreFee.toLocaleString() }}</strong>
            </span>
          </label>
        </div>

        <div v-if="deliveryType === 'home_delivery'" class="shipping-threshold" :class="{ 'is-reached': freeBasicShipping }">
          <div class="shipping-threshold__copy">
            <span>{{ freeBasicShipping ? '已享宅配基本運費優惠' : '再選購 NT$ ' + freeShippingRemaining.toLocaleString() + ' 即享宅配免運' }}</span>
            <strong>滿 NT$ {{ freeShippingThreshold.toLocaleString() }}</strong>
          </div>
          <span class="shipping-threshold__track" aria-hidden="true"><i :style="{ width: shippingProgress + '%' }"></i></span>
        </div>
        <p v-else class="shipping-threshold shipping-threshold--fixed">超商取貨為固定運費，不適用宅配滿額免運。</p>

        <div class="delivery-addons">
          <h3>附加配送服務</h3>
          <label class="addon-checkbox" :class="{ 'is-selected': isRemoteArea }">
            <input type="checkbox" v-model="isRemoteArea">
            <span class="addon-checkbox__indicator" aria-hidden="true"></span>
            <span class="addon-checkbox__copy"><strong>偏遠地區配送</strong><small>離島及指定偏遠區域適用</small></span>
            <span class="addon-checkbox__price">+ NT$ {{ remoteAreaSurcharge.toLocaleString() }}</span>
          </label>
          <label class="addon-checkbox" :class="{ 'is-selected': isSameDayExpress }">
            <input type="checkbox" v-model="isSameDayExpress">
            <span class="addon-checkbox__indicator" aria-hidden="true"></span>
            <span class="addon-checkbox__copy"><strong>當日急件</strong><small>下單後將由專人確認可配送時段</small></span>
            <span class="addon-checkbox__price">+ NT$ {{ sameDayExpressSurcharge.toLocaleString() }}</span>
          </label>
        </div>
      </div>
    </section>

    <aside class="checkout-summary">
      <h2>訂單摘要</h2>
      <div class="checkout-items">
        <div v-for="item in cartItems" :key="item.id" class="checkout-item">
          <img :src="item.product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=160'" :alt="item.product.name">
          <div><strong>{{ item.product.name }}</strong><small>數量 {{ item.quantity }}</small></div>
          <span>NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
        </div>
      </div>
      <div class="checkout-total">
        <div class="total-row"><span>商品小計</span><span>NT$ {{ cartTotal.toLocaleString() }}</span></div>
        <div class="total-row"><span>運費</span><span>NT$ {{ shippingFee.toLocaleString() }}</span></div>
        <div class="total-row is-final"><span>應付總額</span><strong>NT$ {{ orderTotal.toLocaleString() }}</strong></div>
      </div>
      <button @click="submitOrder" :disabled="submitting" class="w-full bg-brand-gold text-white py-3 text-sm font-medium hover:bg-brand-gold-dark transition-colors disabled:opacity-50">
        {{ submitting ? '建立訂單中...' : '建立訂單並繼續付款' }}
      </button>
      <p class="checkout-disclaimer">建立後將前往訂單頁啟動綠界付款，付款結果以後端查詢確認為準。</p>
    </aside>
  </div>
</div>
