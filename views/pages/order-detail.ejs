<div id="app" class="order-page" data-order-id="<%= orderId %>">
  <div class="checkout-progress" aria-label="結帳進度">
    <span><b>01</b> 購物車</span><span><b>02</b> 配送與付款</span><span class="is-current"><b>03</b> 訂單完成</span>
  </div>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <template v-else-if="order">
    <section v-if="order.status === 'paid'" class="payment-complete" aria-labelledby="payment-complete-title">
      <div class="payment-complete__seal" aria-hidden="true">✓</div>
      <h1 id="payment-complete-title">付款完成</h1>
      <p>款項已確認，我們已開始為您準備花禮。</p>

      <div class="payment-receipt">
        <dl>
          <div><dt>訂單編號</dt><dd>{{ order.order_no }}</dd></div>
          <div><dt>付款方式</dt><dd>綠界 ECPay</dd></div>
          <div><dt>付款金額</dt><dd class="is-accent">NT$ {{ order.total_amount.toLocaleString() }}</dd></div>
          <div><dt>配送狀態</dt><dd>準備中</dd></div>
        </dl>
      </div>

      <div class="order-actions">
        <a href="/orders" class="button-primary">查看訂單</a>
        <a href="/" class="button-secondary">回到首頁</a>
      </div>
    </section>

    <section v-else class="order-confirmation" aria-labelledby="order-confirmation-title">
      <div class="order-state-seal" aria-hidden="true">◇</div>
      <h1 id="order-confirmation-title">訂單已建立</h1>
      <p>請在付款期限內前往綠界完成付款，我們將在收到付款結果後開始準備花禮。</p>
      <span>訂單編號 {{ order.order_no }}</span>

      <div class="order-detail-card">
        <dl>
          <div><dt>付款狀態</dt><dd class="is-accent">{{ statusMap[order.status]?.label || order.status }}</dd></div>
          <div><dt>收件人</dt><dd>{{ order.recipient_name }}</dd></div>
          <div><dt>配送地址</dt><dd>{{ order.recipient_address }}</dd></div>
          <div><dt>訂單金額</dt><dd class="is-accent">NT$ {{ order.total_amount.toLocaleString() }}</dd></div>
        </dl>

        <details class="order-items-disclosure">
          <summary>查看商品明細</summary>
          <div v-for="item in order.items" :key="item.id">
            <span>{{ item.product_name }} × {{ item.quantity }}</span>
            <strong>NT$ {{ (item.product_price * item.quantity).toLocaleString() }}</strong>
          </div>
        </details>

        <button
          v-if="!order.payment || order.payment.status === 'failed'"
          type="button"
          class="order-payment-button"
          :disabled="paying"
          @click="startPayment"
        >
          {{ paying ? '處理中…' : (order.status === 'failed' ? '重新前往綠界付款' : '前往綠界付款') }}
        </button>

        <button
          v-if="order.payment && order.payment.status === 'pending'"
          type="button"
          class="order-payment-button"
          :disabled="paying || !order.payment.canVerify"
          @click="verifyPayment"
        >
          {{ paying ? '更新中…' : '更新付款狀態' }}
        </button>

        <p class="payment-deadline">付款狀態將由綠界回傳與後端查詢結果確認。</p>
      </div>
    </section>
  </template>
</div>
